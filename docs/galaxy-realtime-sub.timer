# galaxy-realtime-sub timer:交易日 9:00 拉起订阅进程。
#
# OnCalendar 每日 9:00(北京,服务器 TZ=UTC 即 01:00)触发;RuntimeMaxSec
# 6h30m 保证 15:30 前退出(AM 限并发,不占夜盘会话)。
# 非交易日脚本自查日历直接退出,不占资源。

[Unit]
Description=Galaxy realtime subscription daily 09:00 trigger

[Timer]
OnCalendar=*-*-* 01:00:00 UTC
Persistent=true

[Install]
WantedBy=timers.target

# galaxy-realtime-sub systemd user service + timer。
#
# 盘中实时 K 线订阅(独立进程,9:00–15:30 常驻,AM 限并发故不 24h 跑)。
# scripts/realtime_sub.py:SubscribeData 订阅 8 短周期 → 攒 10s → upsert kline_min*。
# 次日 0:10 scheduler minute cover job 用 query_kline 覆盖定稿。
#
# 部署:cp docs/galaxy-realtime-sub.{service,timer} ~/.config/systemd/user/
#       systemctl --user daemon-reload
#       systemctl --user enable --now galaxy-realtime-sub.timer
#
# 非交易日空跑:脚本启动先查交易日历,非交易日直接退出(0)。

[Unit]
Description=Galaxy realtime K-line subscription (9:00-15:30 trading window)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/laniakea/development/galaxy-quant/galaxy-core
Environment=LD_LIBRARY_PATH=/run/current-system/sw/share/nix-ld/lib
EnvironmentFile=/home/laniakea/development/galaxy-quant/galaxy-core/.env
ExecStart=/home/laniakea/.local/bin/uv run scripts/realtime_sub.py
Restart=on-failure
RestartSec=30s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=galaxy-realtime-sub
# 15:35 强制结束(订阅端到点自停的兜底,防 AM 会话过夜占并发)
RuntimeMaxSec=6h30m

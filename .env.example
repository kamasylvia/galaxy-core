# Galaxy DB Sync 环境变量配置模板
# 复制此文件为 .env 并填入实际值
# 注意：.env 文件应被 .gitignore 排除，不要提交到版本控制
#
# 凭证来源（优先级）:1) Infisical（推荐,业务凭证 GALAXY_*/DB_* 存 Infisical dev 环境,
# 本文件仅填 MI 启动三项即可,业务凭证留空自动从 Infisical 拉）;
# 2) 本文件（无 Infisical 时的直填兜底,公开部署/离线环境用）;
# 3) 代码默认值。详见 README「凭证管理」节。
# =============================================================================
# 项目根目录
# =============================================================================
PROJECT_ROOT_PATH=/home/laniakea/development/galaxy-quant/galaxy-core

# =============================================================================
# Infisical Machine Identity（SDK 启动凭证，必需）
# =============================================================================
# 在 infisical 后台 Machine Identities 创建 Universal Auth，拿 client_id/secret。
# InfisicalConfig.initialize() 用此凭证 POST /api/v1/auth/universal-auth/login
# 换 access_token，然后拉取下方业务凭证。三项缺一不可，否则 SDK 不激活
# （回退到 os.getenv 读本地 .env 兜底）。
INFISICAL_CLIENT_ID=your_machine_identity_client_id
INFISICAL_CLIENT_SECRET=your_machine_identity_client_secret
# workspaceId（项目 ID），对应项目根 .infisical.json 的 workspaceId 字段。
# 注意：不是 Machine Identity 的 identityId！两者格式相同（UUID）易混淆。
INFISICAL_PROJECT_ID=3523da99-6894-443a-ab0f-3f38a462a338

# 可选：Infisical 服务地址（自托管时填，默认 https://app.infisical.com）
# INFISICAL_URL=http://your-infisical-host:port
# 可选：Infisical 环境名（默认 dev）
# INFISICAL_ENVIRONMENT=dev

# =============================================================================
# AmazingData API 配置（必需）
# =============================================================================
GALAXY_USERNAME=your_username
GALAXY_PASSWORD=your_password
GALAXY_HOST=galaxy_server_ip
GALAXY_PORT=galaxy_server_port

# 可选：本地缓存路径（默认 ./data/local_cache/）
# GALAXY_CACHE_PATH=/path/to/local/cache

# =============================================================================
# PostgreSQL 数据库配置（必需）
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=galaxy
DB_USER=postgres
DB_PASSWORD=your_password

# =============================================================================
# 日志配置（可选）
# =============================================================================
# LOG_FILE_PATH=/path/to/logs/app.log

# =============================================================================
# 开发配置（可选）
# =============================================================================
# 数据库连接回显（打印 SQL）
# DB_ECHO=true

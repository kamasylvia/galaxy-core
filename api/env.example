# Application configuration
AGENT_HOST_URL=http://localhost:4322  # The host URL and port number where the app is running.
APP_API_KEY="your api key"
DATA_FOLDER_PATH=data  # The path to the folder that will store the allocation data.

# AI configuration
OPENROUTER_API_KEY="your api key"


# Data retrieval configuration
FMP_API_KEY="your api key"

# Local TimescaleDB (galaxy-core data layer; see docs/deploy.md)
GALAXY_PG_HOST=127.0.0.1
GALAXY_PG_PORT=5432
GALAXY_PG_DB=galaxy
GALAXY_PG_USER=postgres
GALAXY_PG_PASSWORD=postgres
